{
  "name": "iterumspectare",
  "version": "1.0.0",
  "description": "A lightweight recording and replay persistence framework for interactive state changes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "IterumSpectare_logo.png"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "import": "./dist/adapters/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build"
  },
  "keywords": [
    "state",
    "recording",
    "replay",
    "sqlite"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
